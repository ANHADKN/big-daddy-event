# ==========================================
# BIG DADDY EVENTS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your deployment environment.
# NEVER commit real credentials to version control.
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Application Environment (development | production)
NODE_ENV=development

# JWT Secret for Admin Session Signing
# Generate a cryptographically strong 64-byte secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_here

# Initial Admin Account Seeding (Used only on first startup when admins table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_initial_admin_password_here

# Database Selection Architecture
# Allowed values: sqlite (default for local development) | postgres (for production)
DB_CLIENT=sqlite

# Optional: PostgreSQL Database Connection String (Required when DB_CLIENT=postgres or production deployment)
# DATABASE_URL=postgresql://user:password@hostname:5432/database_name?sslmode=require

# Optional: PostgreSQL SSL Enforcement (Set to false for local unencrypted Postgres testing)
# DATABASE_SSL=true

# Optional: Allowed Origins for CORS in Production (comma-separated list, e.g. https://bigdaddyevents.com)
# CORS_ORIGIN=https://bigdaddyevents.com,https://www.bigdaddyevents.com
# ALLOWED_ORIGINS=https://bigdaddyevents.com,https://www.bigdaddyevents.com

# ==========================================
# PRODUCTION DOMAIN & BASE URL (Optional)
# ==========================================
# PUBLIC_BASE_URL=https://bigdaddyevents.com
# API_BASE_URL=https://bigdaddyevents.com/api

# ==========================================
# STORAGE CONFIGURATION (Step 3 Abstraction)
# ==========================================
# Storage Provider: local (default for development) | cloud (for S3/R2/GCS in production)
STORAGE_PROVIDER=local

# Local Storage Directory (Relative to project root or absolute)
STORAGE_UPLOAD_DIR=public/assets/uploads

# Future Cloud Object Storage (Placeholders only - do not enter real credentials in template)
# STORAGE_PROVIDER=cloud
# STORAGE_BUCKET=your-bucket-name
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your-storage-access-key
# STORAGE_SECRET_KEY=your-storage-secret-key
# STORAGE_CDN_URL=https://cdn.bigdaddyevents.com
